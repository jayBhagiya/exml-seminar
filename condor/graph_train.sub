project_dir = /path/to/integrad-showcase
data_dir = /path/to/large-storage/integrad-showcase
campaign = ig-v1

universe = docker
docker_image = pytorch/pytorch:2.2.2-cuda11.8-cudnn8-runtime
initialdir = $(project_dir)
executable = $(project_dir)/condor/run.sh
arguments = -m experiments.graph train --data $(data_dir)/datasets/bbbp --output $(data_dir)/runs/$(campaign)/graph/seed-$(seed) --seed $(seed) --split-seed 42 --epochs 100 --patience 15
environment = "PROJECT_DIR=$(project_dir) DATA_DIR=$(data_dir) VENV=$(data_dir)/venvs/integrad-showcase REQUIRE_CUDA=1"
should_transfer_files = NO
getenv = HOME
+WantGPUHomeMounted = true

output = $(data_dir)/logs/graph-train.$(ClusterId).$(ProcId).out
error = $(data_dir)/logs/graph-train.$(ClusterId).$(ProcId).err
log = $(data_dir)/logs/graph-train.$(ClusterId).$(ProcId).log

request_cpus = 4
request_memory = 16G
request_disk = 10G
request_gpus = 1
requirements = (GPUs_GlobalMemoryMb >= 12000)

queue seed from (
    21
    42
    87
)
