# Create this first: /path/to/large-storage/integrad-showcase/logs
project_dir = /path/to/integrad-showcase
data_dir = /path/to/large-storage/integrad-showcase

universe = docker
docker_image = pytorch/pytorch:2.2.2-cuda11.8-cudnn8-runtime
initialdir = $(project_dir)
executable = $(project_dir)/condor/run.sh
arguments = setup
environment = "PROJECT_DIR=$(project_dir) DATA_DIR=$(data_dir) VENV=$(data_dir)/venvs/integrad-showcase"
should_transfer_files = NO
getenv = HOME
+WantGPUHomeMounted = true

output = $(data_dir)/logs/setup.$(ClusterId).$(ProcId).out
error = $(data_dir)/logs/setup.$(ClusterId).$(ProcId).err
log = $(data_dir)/logs/setup.$(ClusterId).$(ProcId).log

request_cpus = 4
request_memory = 12G
request_disk = 10G
request_gpus = 0

queue 1
