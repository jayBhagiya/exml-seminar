project_dir = /path/to/integrad-showcase
data_dir = /path/to/large-storage/integrad-showcase
campaign = ig-v1

universe = docker
docker_image = pytorch/pytorch:2.2.2-cuda11.8-cudnn8-runtime
initialdir = $(project_dir)
executable = $(project_dir)/condor/run.sh
arguments = "-m experiments.text '$(text)' --baseline $(baseline) --output $(data_dir)/runs/$(campaign)/text/$(sample)/$(baseline) --batch-size 16"
environment = "PROJECT_DIR=$(project_dir) DATA_DIR=$(data_dir) VENV=$(data_dir)/venvs/integrad-showcase REQUIRE_CUDA=1"
should_transfer_files = NO
getenv = HOME
+WantGPUHomeMounted = true

output = $(data_dir)/logs/text.$(ClusterId).$(ProcId).out
error = $(data_dir)/logs/text.$(ClusterId).$(ProcId).err
log = $(data_dir)/logs/text.$(ClusterId).$(ProcId).log

request_cpus = 4
request_memory = 16G
request_disk = 10G
request_gpus = 1
requirements = (GPUs_GlobalMemoryMb >= 12000)

queue sample, baseline, text from (
    positive zero The film is warm, funny, and beautifully acted.
    positive pad The film is warm, funny, and beautifully acted.
    negation zero The film is not good.
    negation pad The film is not good.
    contrast zero The acting is excellent, but the story is painfully dull.
    contrast pad The acting is excellent, but the story is painfully dull.
    intensifier zero This is an extraordinarily bad movie.
    intensifier pad This is an extraordinarily bad movie.
    mixed zero Beautiful photography cannot rescue the weak script.
    mixed pad Beautiful photography cannot rescue the weak script.
    punctuation zero Good? No, it is tedious and predictable.
    punctuation pad Good? No, it is tedious and predictable.
)
