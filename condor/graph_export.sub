# Submit only after graph seed 42 has completed successfully.
project_dir = /path/to/integrad-showcase
data_dir = /path/to/large-storage/integrad-showcase
campaign = ig-v1
checkpoint = $(data_dir)/runs/$(campaign)/graph/seed-42/model.pt

universe = docker
docker_image = pytorch/pytorch:2.2.2-cuda11.8-cudnn8-runtime
initialdir = $(project_dir)
executable = $(project_dir)/condor/run.sh
arguments = -m experiments.graph export --data $(data_dir)/datasets/bbbp --checkpoint $(checkpoint) --index $(index) --baseline $(baseline) --output $(data_dir)/runs/$(campaign)/graph/examples/$(index)/$(baseline) --batch-size 16
environment = "PROJECT_DIR=$(project_dir) DATA_DIR=$(data_dir) VENV=$(data_dir)/venvs/integrad-showcase REQUIRE_CUDA=1"
should_transfer_files = NO
getenv = HOME
+WantGPUHomeMounted = true

output = $(data_dir)/logs/graph-export.$(ClusterId).$(ProcId).out
error = $(data_dir)/logs/graph-export.$(ClusterId).$(ProcId).err
log = $(data_dir)/logs/graph-export.$(ClusterId).$(ProcId).log

request_cpus = 4
request_memory = 16G
request_disk = 10G
request_gpus = 1
requirements = (GPUs_GlobalMemoryMb >= 12000)

# First four examples per class from fixed split; selection ignores predictions.
queue index, baseline from (
    802 zero
    802 mean
    730 zero
    730 mean
    517 zero
    517 mean
    915 zero
    915 mean
    1177 zero
    1177 mean
    1218 zero
    1218 mean
    1889 zero
    1889 mean
    1939 zero
    1939 mean
)
